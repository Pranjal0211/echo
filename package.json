{
  "name": "echo",
  "private": true,
  "description": "Echo — AI communication twin for job-search replies",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "workers/*",
    "apps/*"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @echo/api & npm run dev --workspace @echo/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "db:start": "supabase start -x realtime,storage-api,imgproxy,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:env": "node workers/api/scripts/write-dev-vars.ts",
    "db:seed": "node workers/api/scripts/seed-supabase.ts",
    "db:reset": "supabase db reset && npm run db:seed",
    "test:db": "ECHO_DB_TESTS=1 npm run test --workspace @echo/api"
  },
  "devDependencies": {
    "supabase": "^3.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
